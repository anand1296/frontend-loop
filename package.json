{
  "name": "frontend-loop",
  "private": true,
  "version": "2.0.0",
  "description": "Interview prep for senior, lead and principal engineers: a React app with a Go + Postgres backend, admin CMS, invites and synced progress.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run content:check && tsc --noEmit && vite build",
    "build:single": "node scripts/build-single-file.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "content:check": "node scripts/check-content.ts",
    "check": "npm run content:check && npm run typecheck && npm test",
    "test:e2e": "playwright test",
    "build:web": "npm run content:check && vite build",
    "dev:api": "go run ./cmd/server",
    "test:go": "go test ./...",
    "build:web-esbuild": "node scripts/build-single-file.ts --web",
    "test:e2e:server": "playwright test --project=server"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.0",
    "typescript": "^6.0.0",
    "vite": "^7.0.0"
  }
}

# Copy to .env for local development (`go run ./cmd/server` reads it). Never commit .env.
# On Vercel, set these under Project → Settings → Environment Variables instead.

# Postgres. Local: `docker compose up -d db`. Production: Neon (free) via the Vercel integration.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/frontend_loop?sslmode=disable

# The GitHub login that is always the super admin.
OWNER_GITHUB_LOGIN=anand1296

# GitHub OAuth app (github.com/settings/developers → New OAuth App).
# Callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Canonical origin. Local dev through Vite: http://localhost:5173. Production: https://<your-app>.vercel.app
APP_URL=http://localhost:5173

# Password-less "developer sign-in" for local work and E2E tests. Ignored in production.
DEV_LOGIN=1
